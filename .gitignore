# ==========================================
# Python 运行与构建缓存 (Python & Cache)
# ==========================================
__pycache__/
*.py[cod]
*$py.class
*.so
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# ==========================================
# 虚拟环境 (Virtual Environments)
# ==========================================
venv/
env/
ENV/
.venv/
.env

# ==========================================
# 开发工具与 IDE (Jupyter, VS Code, PyCharm)
# ==========================================
# Jupyter Notebook 缓存
.ipynb_checkpoints
*-checkpoint.ipynb
# VS Code
.vscode/
*.code-workspace
# PyCharm / JetBrains
.idea/

# ==========================================
# 敏感信息与临时文件 (Environment & Credentials)
# ==========================================
.env.local
.env.development.local
.env.test.local
.env.production.local
*.pem
*.key
*.token

# 其它
data/
docs/
.codex/
.opencode/
.workbuddy/
.qoder/
figure/
plotting/
.qoderignore
.opencode
AGENTS.md
dataset
outputs
splits/
AGENTS.md
environment/
examples/
test/
plot_*
tests/

# Keep versioned experiment implementations visible despite broad data/tests ignores.
!experiments/e1_e2/simulation/data/
!experiments/e1_e2/simulation/data/*.py
!experiments/e3/
!experiments/e3/tests/
!experiments/e3/tests/*.py
!experiments/plotting/
!experiments/plotting/*.py
